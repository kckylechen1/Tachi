#!/usr/bin/env python3
"""C1 job hooks sharing the existing local Cargo wrapper's flock inode.

Availability protocol for the owner-accepted single-account host (#2052),
not a cross-account security boundary. No lock bootstrap or environment bypass.
"""
import argparse
import errno
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import re
import signal
import shutil
import stat
import subprocess
import sys
import time
import threading
import uuid

GATE_DIR = Path('/tmp/cargo-gate')
POLL = 0.5
QUEUE_LIMIT = 900.0
WAIT_REPORT = 15.0
POLICY_PATH = Path(__file__).with_name('cargo-gate-policy.json')


class GateError(Exception):
    pass


def fail(code, message):
    raise GateError(f'GATE_E_{code}: {message}')


def holder_log(message):
    # Diagnostics cannot unwind ownership (e.g. a full log filesystem).
    try:
        print(f'cargo-gate: {message}', file=sys.stderr, flush=True)
    except (OSError, ValueError):
        pass


def process(pid):
    result = subprocess.run(
        ['ps', '-p', str(pid), '-o', 'ppid=', '-o', 'lstart=', '-o', 'stat=', '-o', 'comm='],
        capture_output=True, text=True, timeout=5,
        env=dict(os.environ, LC_ALL='C'),
    )
    if result.returncode == 1 and not result.stdout.strip():
        if result.stderr.strip():
            fail('PROCESS', 'process inspection failed with a diagnostic')
        # A no-match result alone does not prove absence: distinguish a live
        # inaccessible/reused PID from ESRCH without signalling that process.
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return None
        except PermissionError:
            fail('PROCESS', 'process absence is unproven')
        fail('PROCESS', 'live process missing from inspection')
    fields = result.stdout.strip().split(None, 7)
    if result.returncode or len(fields) != 8 or not fields[0].isdigit():
        fail('PROCESS', 'cannot establish process identity')
    if fields[6].startswith('Z'):
        return None
    return {'pid': pid, 'start': ' '.join(fields[1:6]),
            'ppid': int(fields[0]), 'command': fields[7]}


def same_process(expected):
    current = process(expected['pid'])
    return current is not None and all(current[k] == expected[k] for k in ('pid', 'start', 'command'))


def worker_for_hook():
    pid = os.getpid()
    for _ in range(32):
        current = process(pid)
        if current is None or current['ppid'] <= 1:
            break
        pid = current['ppid']
        parent = process(pid)
        if parent and Path(parent['command']).name == 'Runner.Worker':
            return parent
    fail('WORKER', 'Runner.Worker ancestor not established')


def job():
    names = ('GITHUB_REPOSITORY', 'GITHUB_WORKFLOW', 'GITHUB_JOB',
             'GITHUB_RUN_ID', 'GITHUB_RUN_ATTEMPT')
    value = {name: os.environ.get(name, '') for name in names}
    if (not all(value.values()) or
            not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', value[names[0]]) or
            not re.fullmatch(r'[A-Za-z0-9_-]+', value[names[2]]) or
            not all(re.fullmatch(r'[0-9]+', value[name]) for name in names[3:])):
        fail('JOB', 'incomplete job identity')
    return value


def light_job(value):
    # The operator installs project policy separately from the host mechanism.
    # An absent policy grants no exemptions; malformed policy refuses the hook.
    if not os.path.lexists(POLICY_PATH):
        return False
    policy = read_json(POLICY_PATH)
    if set(policy) != {'schema', 'light_jobs'} or type(policy['schema']) is not int or policy['schema'] != 1:
        fail('POLICY', 'unsupported host admission policy')
    entries = policy['light_jobs']
    if not isinstance(entries, list) or len(entries) > 64:
        fail('POLICY', 'invalid light job inventory')
    admitted = False
    for entry in entries:
        if (not isinstance(entry, dict) or set(entry) != {'repository', 'workflow', 'jobs'}
                or not isinstance(entry['repository'], str)
                or not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', entry['repository'])
                or not isinstance(entry['workflow'], str) or not entry['workflow']
                or not isinstance(entry['jobs'], list) or len(entry['jobs']) > 64
                or any(not isinstance(name, str) or not re.fullmatch(r'[A-Za-z0-9_-]+', name)
                       for name in entry['jobs'])):
            fail('POLICY', 'invalid light job entry')
        admitted |= (value['GITHUB_REPOSITORY'].lower() == entry['repository'].lower()
                     and value['GITHUB_WORKFLOW'] == entry['workflow']
                     and value['GITHUB_JOB'] in entry['jobs'])
    return admitted


def lease_path(worker, value):
    key = json.dumps([worker, value], sort_keys=True).encode()
    return GATE_DIR / ('ci-lease.' + hashlib.sha256(key).hexdigest())


def read_bytes(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size > 16384:
            fail('STATE', 'invalid gate sidecar')
        with os.fdopen(fd, 'rb', closefd=False) as stream:
            return stream.read(16385)
    finally:
        os.close(fd)


def read_json(path):
    try:
        value = json.loads(read_bytes(path))
    except (ValueError, OSError):
        fail('STATE', 'unreadable or malformed gate sidecar')
    if not isinstance(value, dict):
        fail('STATE', 'gate sidecar must be an object')
    return value


def encode(value):
    return (json.dumps(value, sort_keys=True) + '\n').encode()


def write_exclusive(path, data):
    temporary = path.with_name('.cargo-gate.' + uuid.uuid4().hex + '.tmp')
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, 'wb', closefd=False) as stream:
            stream.write(data)
            stream.flush()
            os.fsync(fd)
        # link publishes fully written bytes without replacing an existing
        # record. Readers never observe a partially created lease/stop path.
        os.link(temporary, path)
    finally:
        os.close(fd)
        try:
            temporary.unlink()
        except OSError:
            # Once published, cleanup failure must not unwind an admitted lease.
            holder_log('GATE_E_CLEANUP: owned temporary sidecar retained')


def remove_owned(path, data):
    try:
        if read_bytes(path) == data:
            path.unlink()
    except FileNotFoundError:
        pass


def open_lock():
    try:
        root = GATE_DIR.lstat()
        if not stat.S_ISDIR(root.st_mode):
            fail('LOCK', 'gate directory must exist and not be a symlink')
        fd = os.open(GATE_DIR / 'lock', os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK)
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size != 0 or info.st_nlink != 1:
            os.close(fd)
            fail('LOCK', 'lock must be an existing empty regular single-link file')
        return fd, [info.st_dev, info.st_ino]
    except OSError:
        fail('LOCK', 'existing machine lock unavailable; no bootstrap or ungated fallback')


def try_lock(fd):
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except OSError as error:
        if error.errno in (errno.EAGAIN, errno.EACCES):
            return False
        fail('LOCK', 'machine lock acquisition failed')


def owner_known():
    owner = read_json(GATE_DIR / 'holder.json')
    if type(owner.get('pid')) is not int or owner['pid'] <= 1:
        fail('OWNER', 'holder PID invalid')
    current = process(owner['pid'])
    if current is None:
        fail('OWNER', 'holder is not live')
    if owner.get('protocol') == 1:
        if (not isinstance(owner.get('holder'), dict) or
                owner['holder'].get('pid') != owner['pid'] or
                not same_process(owner['holder']) or
                not isinstance(owner.get('worker'), dict) or
                not same_process(owner['worker']) or
                Path(owner['worker']['command']).name != 'Runner.Worker'):
            fail('OWNER', 'CI holder identity unproven')
    else:
        # The existing local wrapper writes these four fields, after flock.
        # Confirm the live wrapper itself, not just a reusable numeric PID.
        args = subprocess.run(['ps', '-p', str(owner['pid']), '-o', 'args='],
                              capture_output=True, text=True, timeout=5).stdout.split()
        wrapper = str(Path.home() / 'bin' / 'cargo')
        if (wrapper not in args[:2] or not isinstance(owner.get('argv'), str) or
                not owner['argv'].startswith('cargo ') or
                not isinstance(owner.get('cwd'), str) or
                not isinstance(owner.get('since'), str)):
            fail('OWNER', 'unknown local holder')
    return owner


def known_verifier_open_inode():
    """Wait-only compatibility: a known Hyperion guardian has the gate open.

    An open FD is NOT proof of flock ownership. This observation only permits
    continued waiting; acquire() still admits exclusively via try_lock().
    Malformed/conflicting sidecars retain the existing fail-closed behavior.
    """
    if os.path.lexists(GATE_DIR / 'holder.json') or os.path.lexists(GATE_DIR / 'ci-holder.pid'):
        return False
    lsof = shutil.which('lsof')
    if not lsof:
        return False
    try:
        result = subprocess.run([lsof, '-nP', '-F', 'pn', '--', str(GATE_DIR / 'lock')],
                                capture_output=True, text=True, timeout=5)
        if result.returncode:
            return False
        diagnostic = bool(result.stderr.strip())
        if diagnostic and not sys.platform.startswith('linux'):
            return False
        pid, candidates = None, set()
        for line in result.stdout.splitlines():
            if line.startswith('p') and line[1:].isdigit():
                pid = int(line[1:])
            elif line.startswith('n') and pid and os.path.realpath(line[1:]) == os.path.realpath(GATE_DIR / 'lock'):
                candidates.add(pid)
        for pid in candidates:
            before = process(pid)
            if before is None:
                continue
            if diagnostic:
                # Linux lsof can warn about unrelated Docker mounts while
                # positively reporting this file. Require independent kernel
                # FD/inode evidence; never treat incomplete output as absence.
                target = (GATE_DIR / 'lock').stat()
                matched = False
                for entry in (Path('/proc') / str(pid) / 'fd').iterdir():
                    try:
                        opened = entry.stat()
                    except FileNotFoundError:
                        continue  # Descriptor closed during observation.
                    if (opened.st_dev, opened.st_ino) == (target.st_dev, target.st_ino):
                        matched = True
                        break
                if not matched:
                    continue
            result = subprocess.run(['ps', '-p', str(pid), '-o', 'args='],
                                    capture_output=True, text=True, timeout=5)
            words = result.stdout.split()
            if (result.returncode == 0 and len(words) >= 3 and
                    os.path.isabs(words[1]) and words[1].endswith('/scripts/verification_guard.py') and
                    words[2] == 'guardian' and same_process(before)):
                return True
    except (OSError, subprocess.SubprocessError, GateError):
        pass
    return False


def lock_child(fd, parent_pid, deadline):
    # The inherited open file description transfers custody to the parent when
    # this child exits. Cargo is never launched by this acquisition helper.
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, signal.SIG_DFL)
    def parent_watch():
        # SIGKILL of the holder cannot leave an orphan queued indefinitely.
        # A watchdog thread leaves flock continuously blocked (no signal retry).
        while True:
            if os.getppid() != parent_pid:
                os._exit(70)
            if time.monotonic() >= deadline:
                os._exit(75)
            time.sleep(.1)
    if os.getppid() != parent_pid or time.monotonic() >= deadline:
        fail('LOCK', 'acquisition parent or deadline unavailable')
    threading.Thread(target=parent_watch, daemon=True).start()
    fcntl.flock(fd, fcntl.LOCK_EX)


def acquire(fd, worker, stop, token, queue_seconds):
    started = time.monotonic()
    uncertain_since = None
    child = None
    try:
        if not try_lock(fd):
            # Join the kernel wait alongside local blocking flock callers.
            # Polling below observes cancellation/ownership, not lock admission.
            child = subprocess.Popen(
                [sys.executable, str(Path(__file__).resolve()), 'lock-child', '--fd', str(fd),
                 '--parent-pid', str(os.getpid()), '--deadline', str(started + queue_seconds)],
                pass_fds=(fd,), stdin=subprocess.DEVNULL, close_fds=True)
        while True:
            if stop.exists() and read_json(stop) == {'token': token}:
                fail('INTERRUPTED', 'queued startup cancelled by its hook')
            if not same_process(worker):
                fail('WORKER', 'worker exited while waiting')
            if time.monotonic() - started >= queue_seconds:
                fail('QUEUE_TIMEOUT', 'infra_blocked: shared Cargo admission queue budget exhausted')
            if child is None or child.poll() == 0:
                break
            if child.poll() is not None:
                fail('LOCK', 'blocking acquisition helper failed')
            try:
                owner_known()
                uncertain_since = None
            except GateError:
                if known_verifier_open_inode():
                    uncertain_since = None
                else:
                    # Publication/removal under flock may briefly leave no
                    # sidecar. Persistent unknown state still refuses admission.
                    uncertain_since = uncertain_since or time.monotonic()
                    if time.monotonic() - uncertain_since > 1:
                        raise
            time.sleep(min(POLL, max(0, queue_seconds - (time.monotonic() - started))))
        if not same_process(worker):
            fail('WORKER', 'worker exited before admission')
        if stop.exists():
            if read_json(stop) != {'token': token}:
                fail('STOP', 'conflicting queued stop request')
            fail('INTERRUPTED', 'queued startup cancelled before admission')
        if (GATE_DIR / 'holder.json').exists() or (GATE_DIR / 'ci-holder.pid').exists():
            fail('OWNER', 'unexplained sidecars on an unlocked gate; operator cleanup required')
        now = time.monotonic()
        if now - started >= queue_seconds:
            fail('QUEUE_TIMEOUT', 'infra_blocked: admission budget expired before acknowledgement')
        return {'queue_seconds': now - started, 'acquired_monotonic': now}
    finally:
        if child is not None:
            # Only our unreaped acquisition child may be signalled. No Cargo
            # exists yet; closing the parent's fd releases a cancelled attempt.
            if child.poll() is None:
                child.kill()
            child.wait()


def wait_report(started):
    owner = {}
    try:
        record = read_json(GATE_DIR / 'holder.json')
        if type(record.get('pid')) is int:
            owner['observed_holder_pid'] = record['pid']
        value = record.get('job')
        if isinstance(value, dict):
            for name in ('GITHUB_RUN_ID', 'GITHUB_JOB'):
                if isinstance(value.get(name), str):
                    owner[name] = value[name][:100]
    except (GateError, OSError):
        owner['observed_holder'] = 'unavailable; admission remains fail-closed'
    holder_log('queue_wait ' + json.dumps(dict(owner, elapsed_seconds=round(time.monotonic()-started, 3)), sort_keys=True))


def hold(worker, value, token, queue_seconds):
    fd, identity = open_lock()
    lease = lease_path(worker, value)
    stop = lease.with_name(lease.name + '.stop')
    owned = [(stop, encode({'token': token}))]
    try:
        os.chdir(GATE_DIR)  # outside the runner workspace hygiene boundary
        timing = acquire(fd, worker, stop, token, queue_seconds)
        holder = process(os.getpid())
        record = {'protocol': 1, 'token': token, 'pid': os.getpid(),
                  'holder': holder, 'worker': worker, 'job': value, 'lock': identity,
                  'argv': 'CI job', 'cwd': '(CI)', 'since': time.strftime('%Y-%m-%dT%H:%M:%S'),
                  **timing}
        data = encode(record)
        for path, contents in ((GATE_DIR / 'holder.json', data),
                               (GATE_DIR / 'ci-holder.pid', str(os.getpid()).encode()),
                               (lease, data)):
            write_exclusive(path, contents)
            owned.append((path, contents))
        holder_log('acquired shared machine lock')
        while True:
            try:
                if not same_process(worker):
                    break
                if stop.exists():
                    if read_json(stop) != {'token': token}:
                        fail('STOP', 'stop request does not own this lease')
                    break
            except Exception:
                # Once admitted, uncertainty must retain the lock. An invalid
                # stop request or failed process probe cannot release live Cargo.
                holder_log('GATE_E_ACTIVE_STATE: retaining lock until worker/stop is proven')
            time.sleep(POLL)
    finally:
        for path, contents in reversed(owned):
            try:
                remove_owned(path, contents)
            except (GateError, OSError):
                holder_log('GATE_E_CLEANUP: sidecar retained for operator inspection')
        os.close(fd)


def start(worker, value, queue_seconds=QUEUE_LIMIT):
    fd, identity = open_lock()
    os.close(fd)
    lease = lease_path(worker, value)
    if lease.exists() or lease.with_name(lease.name + '.stop').exists():
        fail('LEASE', 'preexisting job lease requires operator inspection')
    token = uuid.uuid4().hex
    child = None
    admitted = False
    log_fd = os.open(GATE_DIR / 'ci-holder.log',
                     os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    if not stat.S_ISREG(os.fstat(log_fd).st_mode):
        os.close(log_fd)
        fail('LOG', 'holder log must be a regular file')
    try:
        child = subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), 'hold',
             '--worker', json.dumps(worker), '--job', json.dumps(value), '--token', token,
             '--queue-seconds', str(queue_seconds)],
            stdin=subprocess.DEVNULL, stdout=log_fd, stderr=log_fd,
            cwd=GATE_DIR, start_new_session=True, close_fds=True,
        )
        child_identity = process(child.pid)
        started = time.monotonic()
        last_report = -WAIT_REPORT
        holder_log(f'queue_start limit_seconds={queue_seconds:.3f}')
        while not lease.exists():
            elapsed = time.monotonic() - started
            if elapsed - last_report >= WAIT_REPORT:
                wait_report(started)
                last_report = elapsed
            if elapsed >= queue_seconds + 15:
                fail('QUEUE_TIMEOUT', 'infra_blocked: admission acknowledgement deadline exceeded')
            if child.poll() == 75:
                fail('QUEUE_TIMEOUT', 'infra_blocked: shared Cargo admission queue budget exhausted')
            if child.poll() is not None:
                fail('HOLDER_START', 'holder exited before ownership acknowledgement; inspect ci-holder.log')
            if not same_process(worker):
                fail('WORKER', 'worker exited before admission')
            time.sleep(POLL)
        record = read_json(lease)
        if (record.get('token') != token or record.get('worker') != worker or
                record.get('job') != value or record.get('holder') != child_identity or
                record.get('lock') != identity or child.poll() is not None or
                not same_process(child_identity) or not same_process(worker) or
                read_json(GATE_DIR / 'holder.json') != record):
            fail('ACK', 'ownership acknowledgement does not bind this job and holder')
        probe, actual_identity = open_lock()
        try:
            if actual_identity != identity or try_lock(probe):
                fail('ACK', 'acknowledged holder does not retain the shared lock')
        finally:
            os.close(probe)
        admitted = True
        print(f'cargo-gate: CI owns shared lock (holder pid {child.pid}); queue_seconds={record["queue_seconds"]:.3f}', flush=True)
    finally:
        os.close(log_fd)
        if child is not None and not admitted:
            stop = lease.with_name(lease.name + '.stop')
            request = encode({'token': token})
            try:
                write_exclusive(stop, request)
            except FileExistsError:
                pass
            try:
                child.wait(timeout=2)
            except subprocess.TimeoutExpired:
                child.kill()  # our unreaped child; Cargo has not been admitted
                child.wait()
            remove_owned(stop, request)


def end(worker, value):
    lease = lease_path(worker, value)
    if not lease.exists():
        # This job's holder already observed its worker end. Never touch another.
        return
    record = read_json(lease)
    if (record.get('worker') != worker or record.get('job') != value or
            not isinstance(record.get('token'), str) or
            not isinstance(record.get('holder'), dict) or
            not same_process(record['holder'])):
        fail('END', 'job does not own the live lease')
    stop = lease.with_name(lease.name + '.stop')
    request = encode({'token': record['token']})
    try:
        write_exclusive(stop, request)
    except FileExistsError:
        if read_bytes(stop) != request:
            fail('END', 'conflicting stop request')
    deadline = time.monotonic() + 10
    while lease.exists():
        if time.monotonic() > deadline:
            fail('END', 'holder cleanup not acknowledged')
        time.sleep(POLL)
    print('cargo-gate: released this job lease', flush=True)


def snapshot(worker, value):
    record = read_json(lease_path(worker, value))
    if (record.get('protocol') != 1 or record.get('worker') != worker or
            record.get('job') != value or not isinstance(record.get('holder'), dict) or
            not same_process(record['holder']) or not same_process(worker) or
            read_json(GATE_DIR / 'holder.json') != record):
        fail('SNAPSHOT', 'current job does not own a live acknowledged lease')
    for key in ('queue_seconds', 'acquired_monotonic'):
        number = record.get(key)
        if type(number) not in (int, float) or not math.isfinite(number) or number < 0:
            fail('SNAPSHOT', 'installed lease has no valid timing capability')
    if record['acquired_monotonic'] > time.monotonic() or record['queue_seconds'] > QUEUE_LIMIT:
        fail('SNAPSHOT', 'lease timing outside supported bounds')
    fd, identity = open_lock()
    try:
        if record.get('lock') != identity or try_lock(fd):
            fail('SNAPSHOT', 'job lease does not retain the current shared inode')
    finally:
        os.close(fd)
    print(json.dumps(record, sort_keys=True), flush=True)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('action', choices=('start', 'end', 'hold', 'snapshot', 'lock-child'))
    parser.add_argument('--worker')
    parser.add_argument('--job')
    parser.add_argument('--token')
    parser.add_argument('--fd', type=int)
    parser.add_argument('--parent-pid', type=int)
    parser.add_argument('--deadline', type=float)
    parser.add_argument('--queue-seconds', type=float, default=QUEUE_LIMIT)
    args = parser.parse_args()
    if not math.isfinite(args.queue_seconds) or not 0 < args.queue_seconds <= QUEUE_LIMIT:
        fail('QUEUE_LIMIT', 'queue budget must be positive and cannot exceed the installed limit')
    if args.action == 'lock-child':
        lock_child(args.fd, args.parent_pid, args.deadline)
        return
    if args.action == 'hold':
        # No Python callback may reenter buffered diagnostics and unwind flock.
        # A stray signal cannot release ownership; use the job-owned stop path.
        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(sig, signal.SIG_IGN)
        hold(json.loads(args.worker), json.loads(args.job), args.token, args.queue_seconds)
    else:
        def interrupted(*_):
            fail('INTERRUPTED', 'hook interrupted before completion')
        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(sig, interrupted)
        value = job()
        if light_job(value):
            print('cargo-gate: audited no-Cargo job; shared lock not required')
            return
        worker = worker_for_hook()
        if args.action == 'start':
            start(worker, value, args.queue_seconds)
        elif args.action == 'snapshot':
            snapshot(worker, value)
        else:
            end(worker, value)


if __name__ == '__main__':
    try:
        main()
    except (GateError, OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
        error = sys.exc_info()[1]
        message = str(error) if isinstance(error, GateError) else 'GATE_E_RUNTIME: hook or holder failed'
        print(f'cargo-gate: {message}', file=sys.stderr, flush=True)
        sys.exit(75 if isinstance(error, GateError) and str(error).startswith('GATE_E_QUEUE_TIMEOUT:') else 70)
