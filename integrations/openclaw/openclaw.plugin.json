{
  "id": "tachi",
  "name": "Tachi",
  "description": "Advanced structured memory with LLM extraction and hybrid retrieval",
  "kind": "memory",
  "entry": "./index.js",
  "contracts": {
    "tools": [
      "memory_search",
      "memory_get",
      "memory_save",
      "memory_graph",
      "memory_runtime_info",
      "continuity_board",
      "todo_write",
      "todo_read",
      "todo_spawn_summary"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "auditLogPath": {
        "type": "string"
      },
      "topK": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      },
      "captureMinChars": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000
      },
      "captureTriggerKeywords": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "selfEvolutionAgents": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "sharedMemoryAliases": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  }
}
