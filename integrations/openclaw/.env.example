# ─── OpenClaw Tachi Plugin ──────────────────────────────
# Copy this file to .env in the project root directory.
#
# The plugin loads environment variables from .env at startup.
# Most LLM/embedding operations are now handled server-side by Tachi.

# ─── Voyage AI Embedding (used by Tachi server) ───────
# Set this in Tachi's own env, not here (see Tachi README).
# VOYAGE_API_KEY=your_voyage_api_key_here

# ─── Storage ──────────────────────────────────────────
# TACHI_GLOBAL_DB_PATH=~/.tachi/global/memory.db
# TACHI_PROJECT_DB_PATH=~/.tachi/memory.db
# MEMORY_DB_PATH remains accepted as a legacy alias for TACHI_PROJECT_DB_PATH.

# ─── Optional Tuning ─────────────────────────────────
# TACHI_OPENCLAW_EXPERIMENTAL_TACHI_TOOLS=0
# MEMORY_BRIDGE_CAPTURE_MIN_CHARS=200
# MEMORY_BRIDGE_CAPTURE_TRIGGERS=记住,remember,偏好,喜欢,讨厌,生日,地址,电话,邮箱,习惯,计划,deadline,TODO,密码,账号,关键,always,never,重要,important
