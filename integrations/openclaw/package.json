{
  "name": "tachi",
  "version": "1.9.0",
  "private": true,
  "description": "OpenClaw lifecycle plugin for Tachi memory and hub access",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:runtime": "node --test runtime-compat.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@sinclair/typebox": "^0.34.48"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ]
  },
  "overrides": {
    "hono": ">=4.12.25",
    "fast-uri": "4.1.1",
    "@hono/node-server": "2.0.10"
  }
}
