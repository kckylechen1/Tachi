#!/usr/bin/env bash
# Amp orb readiness check for the cloud build/test/review seat.
#
# This hook intentionally provisions nothing. A mutable bootstrap cannot prove
# what toolchain ran a mission, and a seat that lacks a required tool must fail
# before it can produce a review-shaped but unverified result. The orb image
# must provide these command-line tools before this hook is invoked.
set -euo pipefail

export PATH="${PATH}:${CARGO_HOME:-${HOME}/.cargo}/bin"
export RUSTUP_AUTO_INSTALL=0

readonly REQUIRED_TOOLS=(cargo rustc cargo-nextest cargo-audit python3 node npm)
readonly REQUIRED_RUST_COMPONENTS=(clippy rustfmt)
readonly REQUIRED_CARGO_AUDIT_VERSION="0.22.2"
setup_source="${BASH_SOURCE[0]}"
setup_parent="${setup_source%/*}"
if [[ "${setup_parent}" == "${setup_source}" ]]; then
  setup_parent=.
fi
readonly SETUP_DIR="$(cd -- "${setup_parent}" && pwd -P)"
readonly REPO_ROOT="$(cd -- "${SETUP_DIR}/.." && pwd -P)"
readonly RUST_TOOLCHAIN_FILE="${REPO_ROOT}/rust-toolchain.toml"

toolchain_channels=()
toolchain_channel_pattern='^[[:space:]]*channel[[:space:]]*=[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+)"[[:space:]]*$'
while IFS= read -r line; do
  if [[ "${line}" =~ ${toolchain_channel_pattern} ]]; then
    toolchain_channels+=("${BASH_REMATCH[1]}")
  fi
done <"${RUST_TOOLCHAIN_FILE}"

if ((${#toolchain_channels[@]} != 1)); then
  printf 'setup: FAILED -- rust-toolchain.toml must declare exactly one exact semver channel\n' >&2
  exit 1
fi
readonly REQUIRED_RUST_VERSION="${toolchain_channels[0]}"

missing=()

for tool in "${REQUIRED_TOOLS[@]}"; do
  if ! command -v "${tool}" >/dev/null 2>&1 || ! "${tool}" --version >/dev/null 2>&1; then
    missing+=("${tool}")
  fi
done

if command -v node >/dev/null 2>&1 && node_version="$(node --version 2>/dev/null)"; then
  node_major="${node_version#v}"
  node_major="${node_major%%.*}"
  if [[ ! "${node_major}" =~ ^[0-9]+$ ]] || ((node_major < 20)); then
    missing+=("node>=20(found:${node_version:-unknown})")
  fi
fi

if command -v cargo-audit >/dev/null 2>&1; then
  cargo_audit_version="$(cargo-audit --version 2>/dev/null || true)"
  read -r cargo_audit_name cargo_audit_actual _ <<<"${cargo_audit_version}"
  if [[ "${cargo_audit_name:-}" != cargo-audit || "${cargo_audit_actual:-}" != "${REQUIRED_CARGO_AUDIT_VERSION}" ]]; then
    missing+=("cargo-audit=${cargo_audit_actual:-unknown}(required:${REQUIRED_CARGO_AUDIT_VERSION})")
  fi
fi

if command -v rustc >/dev/null 2>&1; then
  rustc_version="$(cd -- "${REPO_ROOT}" && rustc --version 2>/dev/null || true)"
  read -r rustc_name rustc_actual _ <<<"${rustc_version}"
  if [[ "${rustc_name:-}" != rustc || "${rustc_actual:-}" != "${REQUIRED_RUST_VERSION}" ]]; then
    missing+=("rustc=${rustc_actual:-unknown}(required:${REQUIRED_RUST_VERSION})")
  fi
fi

if command -v cargo >/dev/null 2>&1; then
  cargo_version="$(cd -- "${REPO_ROOT}" && cargo --version 2>/dev/null || true)"
  read -r cargo_name cargo_actual _ <<<"${cargo_version}"
  if [[ "${cargo_name:-}" != cargo || "${cargo_actual:-}" != "${REQUIRED_RUST_VERSION}" ]]; then
    missing+=("cargo=${cargo_actual:-unknown}(required:${REQUIRED_RUST_VERSION})")
  fi

  for component in "${REQUIRED_RUST_COMPONENTS[@]}"; do
    case "${component}" in
      clippy) cargo_subcommand="clippy" ;;
      rustfmt) cargo_subcommand="fmt" ;;
      *)
        missing+=("unknown-rust-component:${component}")
        continue
        ;;
    esac

    if ! (cd -- "${REPO_ROOT}" && cargo "${cargo_subcommand}" --version >/dev/null 2>&1); then
      missing+=("${component}@rust-${REQUIRED_RUST_VERSION}")
    fi
  done
fi

# A1 toolchain pin assertion (fail-closed; gated so CI stub harness with SIMULATE_* fakes is unaffected)
if [[ -z "${SIMULATE_CARGO_VERSION:-}" ]]; then
  cargo_resolved="$(command -v cargo 2>/dev/null || echo 'not-found')"
  if command -v cargo >/dev/null 2>&1; then
    cargo_version="$(cd -- "${REPO_ROOT}" && cargo --version 2>/dev/null || true)"
    read -r cargo_name cargo_actual _ <<<"${cargo_version}"
    if [[ "${cargo_name:-}" != cargo || "${cargo_actual:-}" != "${REQUIRED_RUST_VERSION}" ]]; then
      printf 'setup: FAILED -- toolchain pin mismatch\n' >&2
      printf '  cargo --version resolved to: %s\n' "${cargo_actual:-unknown}"
      printf '  required channel from rust-toolchain.toml: %s\n' "${REQUIRED_RUST_VERSION}"
      printf '  command -v cargo: %s\n' "${cargo_resolved}"
      printf '  rustup shims (or direct toolchain bin dir) must precede Homebrew on PATH.\n' >&2
      printf '  Example: export PATH="/Users/kckylechen/.rustup/toolchains/1.97.0-aarch64-apple-darwin/bin:$PATH"\n' >&2
      exit 1
    fi
  fi

  clippy_resolved="$(command -v cargo-clippy 2>/dev/null || echo 'not-found')"
  if command -v cargo-clippy >/dev/null 2>&1; then
    clippy_version="$(cd -- "${REPO_ROOT}" && cargo-clippy --version 2>/dev/null || true)"
    read -r clippy_name clippy_actual _ <<<"${clippy_version}"
    rust_minor="${REQUIRED_RUST_VERSION#*.}"; rust_minor="${rust_minor%%.*}"
    expected_clippy="0.1.${rust_minor}"
    if [[ "${clippy_name:-}" != clippy || "${clippy_actual:-}" != "${expected_clippy}" ]]; then
      printf 'setup: FAILED -- toolchain pin mismatch\n' >&2
      printf '  cargo-clippy --version resolved to: %s\n' "${clippy_actual:-unknown}"
      printf '  required (derived from channel %s): %s\n' "${REQUIRED_RUST_VERSION}" "${expected_clippy}"
      printf '  command -v cargo-clippy: %s\n' "${clippy_resolved}"
      printf '  rustup shims must precede Homebrew on PATH.\n' >&2
      exit 1
    fi
  else
    printf 'setup: FAILED -- toolchain pin: cargo-clippy not resolvable in PATH\n' >&2
    printf '  command -v cargo-clippy: %s\n' "${clippy_resolved}"
    exit 1
  fi
fi

# A1 gh auth sanity (only if gh present; optional tool — do not add hard requirement)
if command -v gh >/dev/null 2>&1; then
  if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    if ! gh api user --jq .login >/dev/null 2>&1; then
      printf 'setup: FAILED -- gh auth sanity: GITHUB_TOKEN is set but invalid (shadows keyring entry)\n' >&2
      printf '  remediation: env -u GITHUB_TOKEN or fix the token\n' >&2
      exit 1
    fi
  fi
  if ! gh auth status >/dev/null 2>&1; then
    printf 'setup: FAILED -- gh present but gh auth status does not resolve a usable token with ambient env\n' >&2
    printf '  run `gh auth login` or ensure GITHUB_TOKEN/keyring provides valid token\n' >&2
    exit 1
  fi
fi

if ((${#missing[@]})); then
  printf 'setup: FAILED -- missing or unusable preinstalled CI tools: %s\n' "${missing[*]}" >&2
  printf 'setup: refusing readiness; provision the orb image, then rerun this check.\n' >&2
  exit 1
fi

printf 'setup: ready -- required command-line tools are usable\n'
for tool in "${REQUIRED_TOOLS[@]}"; do
  "${tool}" --version
done
for component in "${REQUIRED_RUST_COMPONENTS[@]}"; do
  case "${component}" in
    clippy) (cd -- "${REPO_ROOT}" && cargo clippy --version) ;;
    rustfmt) (cd -- "${REPO_ROOT}" && cargo fmt --version) ;;
  esac
done
