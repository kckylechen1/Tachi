#!/usr/bin/env bash
# Provision and verify the pinned toolchain for Amp's cloud build/test seat.
set -euo pipefail

export CARGO_HOME="${CARGO_HOME:-${HOME}/.cargo}"
export RUSTUP_HOME="${RUSTUP_HOME:-${HOME}/.rustup}"
export PATH="${CARGO_HOME}/bin:${PATH}"
export RUSTUP_AUTO_INSTALL=0

readonly REQUIRED_TOOLS=(rustup cargo rustc cargo-nextest cargo-audit python3 node npm)
readonly REQUIRED_RUST_COMPONENTS=(clippy rustfmt)
readonly REQUIRED_CARGO_NEXTEST_VERSION="0.9.140"
readonly REQUIRED_CARGO_AUDIT_VERSION="0.22.2"
readonly RUSTUP_VERSION="1.28.2"
readonly RUSTUP_HOST="x86_64-unknown-linux-gnu"
readonly RUSTUP_INIT_SHA256="20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c"
setup_source="${BASH_SOURCE[0]}"
setup_parent="${setup_source%/*}"
if [[ "${setup_parent}" == "${setup_source}" ]]; then
  setup_parent=.
fi
readonly SETUP_DIR="$(cd -- "${setup_parent}" && pwd -P)"
readonly REPO_ROOT="$(cd -- "${SETUP_DIR}/.." && pwd -P)"
readonly RUST_TOOLCHAIN_FILE="${REPO_ROOT}/rust-toolchain.toml"

toolchain_channels=()
toolchain_channel_pattern='^[[:space:]]*channel[[:space:]]*=[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+)"[[:space:]]*$'
while IFS= read -r line; do
  if [[ "${line}" =~ ${toolchain_channel_pattern} ]]; then
    toolchain_channels+=("${BASH_REMATCH[1]}")
  fi
done <"${RUST_TOOLCHAIN_FILE}"

if ((${#toolchain_channels[@]} != 1)); then
  printf 'setup: FAILED -- rust-toolchain.toml must declare exactly one exact semver channel\n' >&2
  exit 1
fi
readonly REQUIRED_RUST_VERSION="${toolchain_channels[0]}"

rustup_version() {
  local version_output name actual
  if ! command -v rustup >/dev/null 2>&1; then
    return 1
  fi
  version_output="$(rustup --version 2>/dev/null | head -n 1)"
  read -r name actual _ <<<"${version_output}"
  if [[ "${name:-}" != rustup ]]; then
    return 1
  fi
  printf '%s\n' "${actual:-}"
}

if [[ "$(rustup_version || true)" != "${RUSTUP_VERSION}" ]]; then
  if [[ "$(uname -s)-$(uname -m)" != "Linux-x86_64" ]]; then
    printf 'setup: FAILED -- automatic rustup provisioning supports only Amp orb Linux-x86_64\n' >&2
    exit 1
  fi
  for bootstrap_tool in curl sha256sum mktemp; do
    if ! command -v "${bootstrap_tool}" >/dev/null 2>&1; then
      printf 'setup: FAILED -- rustup bootstrap requires %s\n' "${bootstrap_tool}" >&2
      exit 1
    fi
  done

  rustup_init="$(mktemp)"
  trap 'rm -f -- "${rustup_init}"' EXIT
  readonly rustup_url="https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${RUSTUP_HOST}/rustup-init"
  printf 'setup: installing rustup %s from pinned archive\n' "${RUSTUP_VERSION}"
  curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
    --output "${rustup_init}" "${rustup_url}"
  printf '%s  %s\n' "${RUSTUP_INIT_SHA256}" "${rustup_init}" | sha256sum --check --status
  chmod +x "${rustup_init}"
  "${rustup_init}" -y --no-modify-path --profile minimal --default-toolchain none
  rm -f -- "${rustup_init}"
  trap - EXIT
fi

if [[ "$(rustup_version || true)" != "${RUSTUP_VERSION}" ]]; then
  printf 'setup: FAILED -- rustup=%s(required:%s)\n' \
    "$(rustup_version || printf unknown)" "${RUSTUP_VERSION}" >&2
  exit 1
fi

rustup toolchain install "${REQUIRED_RUST_VERSION}" --profile minimal \
  --component clippy --component rustfmt --no-self-update
rustup default "${REQUIRED_RUST_VERSION}"

cargo_tool_version() {
  local tool="$1"
  local version_output name actual
  if ! command -v "${tool}" >/dev/null 2>&1; then
    return 1
  fi
  version_output="$("${tool}" --version 2>/dev/null | head -n 1)"
  read -r name actual _ <<<"${version_output}"
  if [[ "${name:-}" != "${tool}" ]]; then
    return 1
  fi
  printf '%s\n' "${actual:-}"
}

if [[ "$(cargo_tool_version cargo-nextest || true)" != "${REQUIRED_CARGO_NEXTEST_VERSION}" ]]; then
  cargo install cargo-nextest --version "${REQUIRED_CARGO_NEXTEST_VERSION}" --locked --force
fi
if [[ "$(cargo_tool_version cargo-audit || true)" != "${REQUIRED_CARGO_AUDIT_VERSION}" ]]; then
  cargo install cargo-audit --version "${REQUIRED_CARGO_AUDIT_VERSION}" --locked --force
fi

readonly PROFILE_MARKER="# Sigil orb Rust toolchain"
readonly PROFILE_EXPORT="export PATH=\"${CARGO_HOME}/bin:\$PATH\""
if [[ -f "${HOME}/.bash_profile" ]]; then
  readonly LOGIN_PROFILE="${HOME}/.bash_profile"
elif [[ -f "${HOME}/.bash_login" ]]; then
  readonly LOGIN_PROFILE="${HOME}/.bash_login"
else
  readonly LOGIN_PROFILE="${HOME}/.profile"
fi
touch "${LOGIN_PROFILE}"
profile_marker_count="$(grep -Fxc "${PROFILE_MARKER}" "${LOGIN_PROFILE}" || true)"
profile_export_count="$(grep -Fxc "${PROFILE_EXPORT}" "${LOGIN_PROFILE}" || true)"
case "${profile_marker_count}:${profile_export_count}" in
  0:0) printf '\n%s\n%s\n' "${PROFILE_MARKER}" "${PROFILE_EXPORT}" >>"${LOGIN_PROFILE}" ;;
  1:1) ;;
  *)
    printf 'setup: FAILED -- inconsistent Sigil PATH block in %s\n' "${LOGIN_PROFILE}" >&2
    exit 1
    ;;
esac

missing=()

for tool in "${REQUIRED_TOOLS[@]}"; do
  if ! command -v "${tool}" >/dev/null 2>&1 || ! "${tool}" --version >/dev/null 2>&1; then
    missing+=("${tool}")
  fi
done

if command -v node >/dev/null 2>&1 && node_version="$(node --version 2>/dev/null)"; then
  node_major="${node_version#v}"
  node_major="${node_major%%.*}"
  if [[ ! "${node_major}" =~ ^[0-9]+$ ]] || ((node_major < 20)); then
    missing+=("node>=20(found:${node_version:-unknown})")
  fi
fi

if command -v cargo-audit >/dev/null 2>&1; then
  cargo_audit_version="$(cargo-audit --version 2>/dev/null || true)"
  read -r cargo_audit_name cargo_audit_actual _ <<<"${cargo_audit_version}"
  if [[ "${cargo_audit_name:-}" != cargo-audit || "${cargo_audit_actual:-}" != "${REQUIRED_CARGO_AUDIT_VERSION}" ]]; then
    missing+=("cargo-audit=${cargo_audit_actual:-unknown}(required:${REQUIRED_CARGO_AUDIT_VERSION})")
  fi
fi

if command -v cargo-nextest >/dev/null 2>&1; then
  cargo_nextest_actual="$(cargo_tool_version cargo-nextest || true)"
  if [[ "${cargo_nextest_actual}" != "${REQUIRED_CARGO_NEXTEST_VERSION}" ]]; then
    missing+=("cargo-nextest=${cargo_nextest_actual:-unknown}(required:${REQUIRED_CARGO_NEXTEST_VERSION})")
  fi
fi

if command -v rustc >/dev/null 2>&1; then
  rustc_version="$(cd -- "${REPO_ROOT}" && rustc --version 2>/dev/null || true)"
  read -r rustc_name rustc_actual _ <<<"${rustc_version}"
  if [[ "${rustc_name:-}" != rustc || "${rustc_actual:-}" != "${REQUIRED_RUST_VERSION}" ]]; then
    missing+=("rustc=${rustc_actual:-unknown}(required:${REQUIRED_RUST_VERSION})")
  fi
fi

if command -v cargo >/dev/null 2>&1; then
  cargo_version="$(cd -- "${REPO_ROOT}" && cargo --version 2>/dev/null || true)"
  read -r cargo_name cargo_actual _ <<<"${cargo_version}"
  if [[ "${cargo_name:-}" != cargo || "${cargo_actual:-}" != "${REQUIRED_RUST_VERSION}" ]]; then
    missing+=("cargo=${cargo_actual:-unknown}(required:${REQUIRED_RUST_VERSION})")
  fi

  for component in "${REQUIRED_RUST_COMPONENTS[@]}"; do
    case "${component}" in
      clippy) cargo_subcommand="clippy" ;;
      rustfmt) cargo_subcommand="fmt" ;;
      *)
        missing+=("unknown-rust-component:${component}")
        continue
        ;;
    esac

    if ! (cd -- "${REPO_ROOT}" && cargo "${cargo_subcommand}" --version >/dev/null 2>&1); then
      missing+=("${component}@rust-${REQUIRED_RUST_VERSION}")
    fi
  done
fi

if ((${#missing[@]})); then
  printf 'setup: FAILED -- provisioning did not produce required tools: %s\n' "${missing[*]}" >&2
  exit 1
fi

printf 'setup: ready -- required command-line tools are usable\n'
for tool in "${REQUIRED_TOOLS[@]}"; do
  "${tool}" --version
done
for component in "${REQUIRED_RUST_COMPONENTS[@]}"; do
  case "${component}" in
    clippy) (cd -- "${REPO_ROOT}" && cargo clippy --version) ;;
    rustfmt) (cd -- "${REPO_ROOT}" && cargo fmt --version) ;;
  esac
done
