#!/usr/bin/env bash
# Amp orb readiness check for the cloud build/test/review seat.
#
# This hook intentionally provisions nothing. A mutable bootstrap cannot prove
# what toolchain ran a mission, and a seat that lacks a required tool must fail
# before it can produce a review-shaped but unverified result. The orb image
# must provide these command-line tools before this hook is invoked.
set -euo pipefail

export PATH="${CARGO_HOME:-${HOME}/.cargo}/bin:${PATH}"
export RUSTUP_AUTO_INSTALL=0

readonly REQUIRED_TOOLS=(cargo rustc cargo-nextest cargo-audit python3 node npm)
readonly REQUIRED_RUST_COMPONENTS=(clippy rustfmt)

missing=()

for tool in "${REQUIRED_TOOLS[@]}"; do
  if ! command -v "${tool}" >/dev/null 2>&1 || ! "${tool}" --version >/dev/null 2>&1; then
    missing+=("${tool}")
  fi
done

if command -v node >/dev/null 2>&1 && node_version="$(node --version 2>/dev/null)"; then
  node_major="${node_version#v}"
  node_major="${node_major%%.*}"
  if [[ ! "${node_major}" =~ ^[0-9]+$ ]] || ((node_major < 20)); then
    missing+=("node>=20(found:${node_version:-unknown})")
  fi
fi

if command -v cargo >/dev/null 2>&1; then
  for component in "${REQUIRED_RUST_COMPONENTS[@]}"; do
    case "${component}" in
      clippy) cargo_subcommand="clippy" ;;
      rustfmt) cargo_subcommand="fmt" ;;
      *)
        missing+=("unknown-rust-component:${component}")
        continue
        ;;
    esac

    if ! cargo "${cargo_subcommand}" --version >/dev/null 2>&1; then
      missing+=("${component}")
    fi
  done
fi

if ((${#missing[@]})); then
  printf 'setup: FAILED -- missing or unusable preinstalled CI tools: %s\n' "${missing[*]}" >&2
  printf 'setup: refusing readiness; provision the orb image, then rerun this check.\n' >&2
  exit 1
fi

printf 'setup: ready -- required command-line tools are usable\n'
for tool in "${REQUIRED_TOOLS[@]}"; do
  "${tool}" --version
done
for component in "${REQUIRED_RUST_COMPONENTS[@]}"; do
  case "${component}" in
    clippy) cargo clippy --version ;;
    rustfmt) cargo fmt --version ;;
  esac
done
