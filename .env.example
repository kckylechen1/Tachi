# ─── Embedding & Reranking ─────────────────────────────
# Voyage remains the recommended provider for vector embedding + rerank.
VOYAGE_API_KEY=your_voyage_api_key_here

# ─── Shared OpenAI-Compatible Defaults ─────────────────
# Phase 2 (LLM 3-layer consolidation): SiliconFlow/Qwen is the only required
# raw-API default. Extract, summary, and distill use configured API lanes;
# ordinary reasoning may still try Claude CLI first. The retired ClaudePool
# wrapper and TACHI_CLAUDE_POOL_PROVIDER_FIRST rollout flag were removed in
# issue #1261; the lane-specific defaults are documented below.
#
# DISTILL_* and REASONING_* configure active model lanes. MINIMAX_* remains
# recognised only for back-compat with existing installs. A minimal deployment
# can start with SILICONFLOW_API_KEY + VOYAGE_API_KEY.
SILICONFLOW_API_KEY=your_default_chat_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
SILICONFLOW_MODEL=Qwen/Qwen3.5-27B

# ─── Lane: Extraction ──────────────────────────────────
# Best for high-recall structured JSON extraction.
EXTRACT_API_KEY=
EXTRACT_BASE_URL=
EXTRACT_MODEL=Qwen/Qwen3.5-27B

# ─── Lane: Distillation / Compaction ───────────────────
# Daily batch distill always uses this API lane. `claude_cli` remains accepted
# as a legacy FOUNDRY_DISTILL_BACKEND selector but does not launch Claude CLI.
# DISTILL_* is the explicit first choice; without it, key resolution falls
# through DeepSeek, reasoning, ZAI/BigModel, extract, then SiliconFlow.
FOUNDRY_DISTILL_BACKEND=raw_api
FOUNDRY_DISTILL_BATCH_SIZE=6
DISTILL_API_KEY=
DISTILL_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
DISTILL_MODEL=deepseek-ai/DeepSeek-V4-Flash

# ─── Lane: Reasoning / Evolution ───────────────────────
# Ordinary reasoning/chat tries Claude CLI before this configured API lane;
# provider-only callers use the API lane directly. API key resolution prefers
# DeepSeek, then REASONING_*, ZAI/BigModel, DISTILL_*, extract, and SiliconFlow.
REASONING_API_KEY=
REASONING_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4/chat/completions
REASONING_MODEL=glm-5.1

# ─── Lane: Summary ─────────────────────────────────────
# Used by fast L0 summaries; defaults to EXTRACT_* when omitted.
# L0 summaries are lightweight; Qwen3.5-27B is fast and cost-effective.
SUMMARY_API_KEY=
SUMMARY_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
SUMMARY_MODEL=Qwen/Qwen3.5-27B

# ─── Legacy Compatibility ──────────────────────────────
# These still work, but are now lower-priority fallbacks.
EXTRACTOR_BASE_URL=
EXTRACTOR_MODEL=

# ─── Storage Configurations ────────────────────────────
MEMORY_DB_PATH=~/.tachi/global/tachi-memory.db

# ─── Tachi Home ────────────────────────────────────────
# TACHI_HOME=~/.tachi

# ─── Daemon & Transport ────────────────────────────────
# TACHI_DISABLE_AUTO_DAEMON=false
# TACHI_DISABLE_STDIO_PROXY=false
# TACHI_EMBEDDED_MCP=false
# TACHI_DAEMON_IDLE_TIMEOUT_SECS=1800
# TACHI_WAL_CHECKPOINT_SECS=300

# ─── Memory GC ─────────────────────────────────────────
# MEMORY_GC_ENABLED=true
# MEMORY_GC_INITIAL_DELAY_SECS=60
# MEMORY_GC_INTERVAL_SECS=3600
# MEMORY_GC_STALE_DAYS=30

# ─── Pipeline & Foundry ────────────────────────────────
# ENABLE_PIPELINE=true
# DISTILL_INTERVAL_SECS=3600

# ─── Rate Limiting ─────────────────────────────────────
# RATE_LIMIT_RPM=0
# RATE_LIMIT_BURST=8

# ─── Pool Sizes ────────────────────────────────────────
# TACHI_MEMORY_READ_POOL_SIZE=4
# Caps concurrent recorded LLM calls writing to foundry-runs/ (issue #1261:
# formerly CLAUDE_POOL_MAX_CONCURRENT — the Claude CLI pool was removed;
# the env name is kept for back-compat with existing deployments).
# CLAUDE_POOL_MAX_CONCURRENT=2

# ─── MCP Discovery ─────────────────────────────────────
# MCP_DISCOVERY_TIMEOUT_MS=5000
# MCP_TOOL_EXPOSURE_MODE=filtered

# ─── Additional Provider Keys (Optional) ──────────────
# DEEPSEEK_API_KEY=
# ZAI_API_KEY=

# ─── i18n ──────────────────────────────────────────────
# TACHI_LOCALE=en
