# ─── Embedding & Reranking ─────────────────────────────
# Voyage remains the recommended provider for vector embedding + rerank.
VOYAGE_API_KEY=your_voyage_api_key_here

# ─── Shared OpenAI-Compatible Defaults ─────────────────
# Phase 2 (LLM 3-layer consolidation): SiliconFlow/Qwen is the only
# required raw-API lane. Background skill/foundry calls now go through
# the Claude CLI pool first and fall back to SILICONFLOW_* on error.
#
# DISTILL_* / REASONING_* / MINIMAX_* below are DEPRECATED — they remain
# recognised for back-compat with existing installs, but new deployments
# only need SILICONFLOW_API_KEY + VOYAGE_API_KEY.
SILICONFLOW_API_KEY=your_default_chat_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
SILICONFLOW_MODEL=Qwen/Qwen3.5-27B

# ─── Lane: Extraction ──────────────────────────────────
# Best for high-recall structured JSON extraction.
EXTRACT_API_KEY=
EXTRACT_BASE_URL=
EXTRACT_MODEL=Qwen/Qwen3.5-27B

# ─── Lane: Distillation / Compaction ───────────────────
# DEPRECATED (Phase 2): recall compaction now routes through
# call_extract_llm (SiliconFlow/Qwen) and daily distill goes through the
# Claude CLI pool. Kept for back-compat only.
DISTILL_API_KEY=
DISTILL_BASE_URL=https://api.minimaxi.com/v1/chat/completions
DISTILL_MODEL=MiniMax-M2.7

# ─── Lane: Reasoning / Evolution ───────────────────────
# DEPRECATED (Phase 2): skill_evolve / agent evolution now route through
# the Claude CLI pool with SiliconFlow/Qwen as the raw_api fallback.
# Kept for back-compat only.
REASONING_API_KEY=
REASONING_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4/chat/completions
REASONING_MODEL=glm-5.1

# ─── Lane: Summary ─────────────────────────────────────
# Used by fast L0 summaries; defaults to EXTRACT_* when omitted.
# L0 summaries are lightweight; Qwen3.5-27B is fast and cost-effective.
SUMMARY_API_KEY=
SUMMARY_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
SUMMARY_MODEL=Qwen/Qwen3.5-27B

# ─── Legacy Compatibility ──────────────────────────────
# These still work, but are now lower-priority fallbacks.
EXTRACTOR_BASE_URL=
EXTRACTOR_MODEL=

# ─── Storage Configurations ────────────────────────────
MEMORY_DB_PATH=~/.tachi/memory.db
