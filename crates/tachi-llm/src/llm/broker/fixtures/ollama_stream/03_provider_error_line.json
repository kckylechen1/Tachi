{
  "grammar": "ollama_ndjson",
  "why": "A mid-stream Ollama error is provider-declared failure, not a decode error. The decoder points at `/error` and leaks none of the provider's prose even though the bytes carried it.",
  "chunks": [
    {
      "text": "{\"model\":\"qwen3\",\"message\":{\"role\":\"assistant\",\"content\":\"Hel\"},\"done\":false}\n"
    },
    {
      "text": "{\"error\":\"model overloaded right now\"}\n"
    }
  ],
  "terminal_input": {
    "kind": "finish",
    "eof": "clean"
  },
  "must_not_leak": [
    "model overloaded right now"
  ],
  "expected": {
    "events": [
      {
        "event": "started",
        "metadata": {
          "effective_model": "qwen3"
        }
      },
      {
        "event": "text_delta",
        "text": "Hel"
      },
      {
        "event": "failed",
        "disposition": {
          "disposition": "protocol_error",
          "violation": {
            "kind": "schema_violation",
            "pointer": "/error"
          }
        }
      }
    ],
    "error": null,
    "terminal_disposition": {
      "disposition": "protocol_error",
      "violation": {
        "kind": "schema_violation",
        "pointer": "/error"
      }
    }
  }
}
