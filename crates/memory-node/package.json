{
  "name": "@chaoxlabs/tachi-node",
  "version": "1.6.0",
  "description": "High-performance memory storage & hybrid search engine (Rust native module)",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    }
  },
  "napi": {
    "name": "tachi",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release --cargo-cwd .",
    "build:debug": "napi build --platform --cargo-cwd .",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm --skip-gh-release"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2"
  },
  "license": "AGPL-3.0-only",
  "repository": "https://github.com/kckylechen1/tachi",
  "homepage": "https://github.com/kckylechen1/tachi",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "*.node"
  ]
}
